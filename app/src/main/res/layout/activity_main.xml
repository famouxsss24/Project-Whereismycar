<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0">

    <!-- ═══════════════ 1) 메인 화면 (검색) ═══════════════ -->
    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="48dp">

        <!-- 타이틀 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚗 내 차로"
            android:textSize="60sp"
            android:textStyle="bold"
            android:textColor="#FF6B6B"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="차량 번호판 뒷 4자리를 입력해 주세요"
            android:textSize="22sp"
            android:textColor="#A89A95"
            android:layout_marginBottom="44dp"/>

        <!-- 뒷 4자리 입력 -->
        <EditText
            android:id="@+id/etPlateNumber"
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:hint="0000"
            android:textSize="56sp"
            android:textColor="#3C3237"
            android:textColorHint="#D8CCC5"
            android:inputType="number"
            android:maxLength="4"
            android:gravity="center"
            android:padding="24dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="380dp"
            android:layout_height="88dp"
            android:text="차량 찾기"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF6B6B"
            android:layout_marginBottom="36dp"/>

        <!-- 상태 메시지 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Temi 연결 대기 중..."
            android:textSize="20sp"
            android:textColor="#A89A95"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- 단일 결과: 구역 표시 -->
        <TextView
            android:id="@+id/tvZone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="84sp"
            android:textStyle="bold"
            android:textColor="#FF6B6B"
            android:layout_marginBottom="16dp"/>

        <!-- 중복 결과: 번호판 이미지 선택 -->
        <TextView
            android:id="@+id/tvSelectLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="본인 차량을 선택해 주세요 🚙"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#3C3237"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp"/>

        <HorizontalScrollView
            android:id="@+id/scrollPlates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/llPlateImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"/>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- ═══════════════ 2) 결제 옵션 선택 화면 (참고용, 미사용) ═══════════════ -->
    <LinearLayout
        android:id="@+id/paymentOptionLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="48dp"
        android:background="#FFF8F0"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💳 결제 안내"
            android:textSize="44sp"
            android:textStyle="bold"
            android:textColor="#FF6B6B"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="40dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="32dp"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="차량 번호"
                    android:textSize="22sp"
                    android:textColor="#A89A95"/>
                <TextView
                    android:id="@+id/tvPaymentPlate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="22sp"
                    android:textColor="#3C3237"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="주차 시간"
                    android:textSize="22sp"
                    android:textColor="#A89A95"/>
                <TextView
                    android:id="@+id/tvParkingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="22sp"
                    android:textColor="#3C3237"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="정산 요금"
                    android:textSize="22sp"
                    android:textColor="#A89A95"/>
                <TextView
                    android:id="@+id/tvOriginalFee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="28sp"
                    android:textColor="#FF6B6B"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡  광고 시청 시 30% 할인 + 포인트 적립"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#E89B2B"
            android:gravity="center"
            android:padding="18dp"
            android:background="@drawable/bg_banner"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnPayDirect"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:text="지금 결제"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C9B8B0"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnPayWithAd"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:text="광고 보고 30% 할인받기"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF6B6B"/>

    </LinearLayout>

    <!-- ═══════════════ 3) 광고 영상 재생 (전체 화면) ═══════════════ -->
    <FrameLayout
        android:id="@+id/adLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📺 광고 시청 중 (스킵 불가)"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:background="#99000000"
            android:padding="10dp"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"/>

    </FrameLayout>

    <!-- ═══════════════ 4) 퀴즈 화면 ═══════════════ -->
    <LinearLayout
        android:id="@+id/quizLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        android:background="#FFF8F0"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 광고 퀴즈"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#E89B2B"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="정답 시 +100 포인트 🎁"
            android:textSize="20sp"
            android:textColor="#A89A95"
            android:layout_marginBottom="48dp"/>

        <TextView
            android:id="@+id/quizQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="류현진이 먹은 라면은?"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="#3C3237"
            android:gravity="center"
            android:layout_marginBottom="60dp"/>

        <Button
            android:id="@+id/btnAnswer1"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:text="신라면"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#3C3237"
            android:backgroundTint="#FFFFFF"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnAnswer2"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:text="진라면"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#3C3237"
            android:backgroundTint="#FFFFFF"/>

    </LinearLayout>

    <!-- ═══════════════ 5) Temi 이동 중 화면 (네비게이션) ═══════════════ -->
    <FrameLayout
        android:id="@+id/navLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFF8F0"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚗"
                android:textSize="120sp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tvNavZone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="84sp"
                android:textStyle="bold"
                android:textColor="#FF6B6B"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:id="@+id/tvNavStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="안내 중..."
                android:textSize="26sp"
                android:textColor="#3C3237"/>
        </LinearLayout>

        <!-- 우측 상단: 작은 네비게이션 박스 -->
        <LinearLayout
            android:id="@+id/navigationBox"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="24dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_navbox">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 NAVIGATION"
                android:textColor="#E89B2B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/navInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="목적지: -\n상태: 대기 중\n방향: -"
                android:textColor="#3C3237"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"/>
        </LinearLayout>

    </FrameLayout>

    <!-- ═══════════════ 6) 카카오페이 WebView 오버레이 ═══════════════ -->
    <FrameLayout
        android:id="@+id/layoutWebViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC3C3237"
        android:padding="40dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="내차로 결제 — 카카오페이"
                android:textColor="#3C3237"
                android:textStyle="bold"
                android:textSize="20sp"
                android:gravity="center"
                android:background="#FFEB3B"/>

            <WebView
                android:id="@+id/paymentWebView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
